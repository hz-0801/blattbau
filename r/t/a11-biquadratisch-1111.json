{"titel": "Biquadratische Gleichungen", "p": [[1, "a", "$x = \\pm 2$, $x = \\pm 3$", "$z^2 - 13z + 36 = 0$; $z_1 = 4,\\ z_2 = 9$", 0], [1, "b", "$x = \\pm 2$", "$z^2 - 3z - 4 = 0$; $z_1 = 4,\\ z_2 = -1 \\text{ (kein } x)$", 0], [1, "c", "$x = \\pm 1$, $x = \\pm 4$", "$x^4 - 17x^2 + 16 = 0,\\ z^2 - 17z + 16 = 0$; $z_1 = 1,\\ z_2 = 16$", 0], [1, "d", "$x = \\pm\\sqrt{3} \\approx \\pm 1{,}73$, $x = \\pm 2$", "$z^2 - 7z + 12 = 0$; $z_1 = 3,\\ z_2 = 4$", 0], [2, "", "nein, nur $x = \\pm\\sqrt{3}$", "$z = -4$ liefert kein $x$, da $x^2 \\geq 0$", 1], [3, "", "keine Nullstelle", "$z^2 + 5z + 6 = 0$: $z_1 = -2$, $z_2 = -3$, beide negativ", 0], [4, "", "$x = \\pm 3$", "$x^4 - 8x^2 - 9 = 0$; $z_1 = 9$, $z_2 = -1$", 0]], "b": {}, "pdf": "a11-biquadratisch-1111.pdf", "bis": "2026-12-09"}