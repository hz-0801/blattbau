% Knoten: Label, Nummer, x, y, Winkel nach außen (für die Schleife)
\cs_new_protected:Npn \__mb_pd_knoten:nnnnn #1#2#3#4#5
  {
    \prop_put:Nnn \l__mb_pd_name_prop {#1} {#2}
    \prop_put:Nnn \l__mb_pd_winkel_prop {#2} {#5}
