% ---------------------------------------------------------------------------
% P  Pfeildiagramme zu Matrizen: Übergangsdiagramm und Verflechtungsdiagramm (neuer Abschnitt)
% ---------------------------------------------------------------------------
% \uebergangsdiagramm{Zustände}{Pfeile}
%   Zustände mit Komma (Mathelabels; Wörter als \text{Larve}). Sie liegen auf einem Kreis:
%   zwei nebeneinander, drei als Dreieck mit der Spitze oben, vier als Quadrat usw.
%   Pfeile mit Komma, je Pfeil Von>Nach/Wert; Von = Nach ist die Schleife (nach außen).
%   Leerer Wert (A>B/) = Feld zum Eintragen. Gibt es zwischen zwei Zuständen beide Richtungen,
%   werden beide Pfeile gebogen, sonst sind sie gerade.
% \uebergangsdiagramm[2.4]{...}{...}   Abstand Mitte–Zustand in cm (Voreinstellung 1,8)
% Beispiel (matrizen-und-uebergangsprozesse-e4-k1-s1-v1, Lösungsgrafik; Studio A, Studio B):
%   \uebergangsdiagramm{A,B}{A>A/0{,}9, A>B/0{,}1, B>A/0{,}15, B>B/0{,}85}
% Beispiel (matrizen-und-uebergangsprozesse-e4-k1-s1-v2, Lösungsgrafik; kein Pfeil C → B):
%   \uebergangsdiagramm{A,B,C}{A>A/0{,}6, A>B/0{,}3, A>C/0{,}1, B>B/0{,}5, B>A/0{,}25, B>C/0{,}25,
%     C>C/0{,}8, C>A/0{,}2}
% \verflechtungsdiagramm{Stufen}{Pfeile}
%   Stufen mit Semikolon, Knoten einer Stufe mit Komma; die Stufen stehen von links nach rechts,
%   ihre Knoten untereinander. Pfeile wie oben (Von>Nach/Wert), gerade, Wert im ersten Drittel.
% Beispiel (matrizen-und-uebergangsprozesse-e3-k1-s2-v1, bisher Pfeilliste im Aufgabentext):
%   \verflechtungsdiagramm{R_1,R_2,R_3;Z_1,Z_2}{R_1>Z_1/2, R_1>Z_2/5, R_2>Z_2/1, R_3>Z_1/4}
\newcommand{\mbpdanfang}{\begin{tikzpicture}[baseline=(current bounding box.north),line width=0.6pt,
     zst/.style={draw,circle,minimum size=8mm,inner sep=1pt,font=\small},
     wk/.style={font=\scriptsize,fill=white,inner sep=1pt},
     pf/.style={-{Stealth[length=2mm]},line width=0.7pt}]}
\newcommand{\mbpdende}{\end{tikzpicture}}
\newcommand{\mbpdknoten}[4]{\node[zst] (#1) at (#2,#3) {$#4$};}% Name, x, y, Label
\newcommand{\mbpdwert}[1]{\ifblank{#1}{\underline{\hspace{5mm}}}{$#1$}}
% Pfeil: von, nach, Biegung in Grad (0 = gerade), Wert, Lage des Werts entlang des Pfeils
\newcommand{\mbpdpfeil}[5]{\draw[pf] (#1) to[bend left=#3] node[wk,pos=#5] {\mbpdwert{#4}} (#2);}
% Schleife: Knoten, Austrittswinkel, Eintrittswinkel, Wert
\newcommand{\mbpdschleife}[4]{\draw[pf] (#1) to[loop,out=#2,in=#3,min distance=6mm] node[wk] {\mbpdwert{#4}} (#1);}
