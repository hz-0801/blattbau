    \tl_set:Nx \l__mb_pd_hilf_tl { \seq_item:Nn \l__mb_pd_teil_seq { 1 } }
    \exp_args:NNno \seq_set_split:Nnn \l__mb_pd_ab_seq { > } { \l__mb_pd_hilf_tl }
    \__mb_pd_nummer:nN { 1 } \l__mb_pd_von_tl
    \__mb_pd_nummer:nN { 2 } \l__mb_pd_nach_tl
