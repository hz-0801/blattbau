              {
                \tl_set:Nn \l__mb_pd_pos_tl { 0.5 }
                \seq_if_in:NVT \l__mb_pd_paare_seq \l__mb_pd_hilf_tl
                  { \tl_set:Nn \l__mb_pd_bieg_tl { 18 } }
              }
            \use:x
              {
                \exp_not:N \mbpdpfeil { mbpd \l__mb_pd_von_tl } { mbpd \l__mb_pd_nach_tl }
                  { \l__mb_pd_bieg_tl } { \exp_not:V \l__mb_pd_wert_tl } { \l__mb_pd_pos_tl }
              }
